# 数据库配置
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=AI_records_and_reminders
DATABASE_USER=AI_records_and_reminders
DATABASE_PASSWORD=change-me

# 后端配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=18100
SECRET_KEY=change-me-to-a-random-string

# NapCat配置
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=

# 静态文件路径
STATIC_DIR=./static

# 部署脚本配置（仅填写到本地 .env，不要提交到仓库）
DEPLOY_REMOTE_HOST=your-server-host
DEPLOY_REMOTE_PORT=22
DEPLOY_REMOTE_USER=your-ssh-user
DEPLOY_SSH_KEY_PATH=C:/path/to/your/private_key
DEPLOY_REMOTE_BASE=/www/wwwroot/AI_records_and_reminders
DEPLOY_PYTHON_BIN=/path/to/python
DEPLOY_BACKEND_PORT=18100
# deploy.py 使用系统 OpenSSH，建议始终采用 SSH 私钥认证

# 公网验收配置（仅填写到本地 .env，不要提交到仓库）
REMOTE_SMOKE_BASE_URL=https://example.com
REMOTE_SMOKE_USERNAME=change-me
REMOTE_SMOKE_PASSWORD=change-me
